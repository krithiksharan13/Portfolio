{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "krithik-sharan-portfolio",
      "version": "0.1.0",
      "title": "Krithik Sharan Portfolio"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get profile",
        "description": "Get Krithik Sharan S A's profile summary: headline, current focus, contact links and portfolio site.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_experience",
        "title": "List work experience",
        "description": "List Krithik's work experience entries (role, company, duration, description, achievements). Optionally filter by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "professional",
                "minor",
                "other",
                "all"
              ],
              "description": "Which experience group to return. Defaults to all."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List Krithik's portfolio projects and hackathon projects, including tools used and repository or live links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "portfolio",
                "hackathon",
                "all"
              ],
              "description": "Which project group to return. Defaults to all."
            },
            "search": {
              "type": "string",
              "description": "Case-insensitive text filter on title, description or tools."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_certificates",
        "title": "List certifications",
        "description": "List Krithik's certifications grouped by category (Data Analytics, AI, Forage, Academic, Non-Academic), with issuer, date and verification link when available.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category name filter, e.g. 'Forage'."
            },
            "issuer": {
              "type": "string",
              "description": "Optional issuer filter, e.g. 'Udemy'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_volunteering",
        "title": "List volunteering",
        "description": "List Krithik's volunteering roles with organisation, duration and contributions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_education",
        "title": "List education",
        "description": "List Krithik's education history with degrees, institutions, grades and modules.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
