# Frontend (Vite) — Supabase "portfolio" project
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Serverless (api/chat.ts) — set in Vercel -> Project Settings -> Environment Variables.
# Not needed for `npm run dev` (the chat function only runs on Vercel).
GEMINI_API_KEY="YOUR_GOOGLE_AI_STUDIO_KEY"
